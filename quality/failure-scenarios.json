      "human_review": true
    },
    {
      "id": "V002",
      "name": "water_depth_unknown",
      "input": "Water depth/current/passability cannot be established",
      "expected": "display_unknown_do_not_enter",
      "human_review": true
    },
    {
      "id": "V003",
      "name": "route_risk",
      "input": "Planned route crosses a reported flooded segment",
      "expected": "warn_and_suggest_alternative_if_reliable",
      "human_review": true
    },
    {
      "id": "V004",
      "name": "sensor_disagreement",
      "input": "Vehicle/weather/road sensors disagree",
      "expected": "lower_confidence_and_request_driver_attention",
      "human_review": true
    },
    {
      "id": "V005",
      "name": "map_or_gnss_loss",
      "input": "Map or GNSS context is unavailable",
      "expected": "mark_route_context_unknown",
      "human_review": true
    },
    {
      "id": "V006",
      "name": "driver_rejection",
      "input": "Driver rejects a route suggestion",
      "expected": "cancel_advisory_no_vehicle_control",
      "human_review": true
    },
    {
      "id": "V007",
      "name": "communications_loss",
      "input": "Connected data service is unavailable",
      "expected": "show_data_unavailable_no_false_reassurance",
      "human_review": true
    },
    {
      "id": "V008",
      "name": "battery_thermal_fault",
      "input": "Vehicle battery or thermal warning is received",
