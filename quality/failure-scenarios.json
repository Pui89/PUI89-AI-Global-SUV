    },
    {
      "id": "V009",
      "name": "false_positive_review",
      "input": "Flood or hazard alert is disputed",
      "expected": "show_source_and_uncertainty_for_human_review",
      "human_review": true
    },
    {
      "id": "V010",
      "name": "unknown_road_condition",
      "input": "Road passability cannot be verified",
      "expected": "advise_avoidance_no_wading_claim",
      "human_review": true
    }
